# Keep this service private. Anyone with Docker daemon access can control the host.
WORKER_PORT=8787
WORKER_TOKEN=replace-with-the-same-long-random-worker-token-as-the-control-plane
# Generate a SEPARATE worker-only key: openssl rand -hex 32
WORKER_ENCRYPTION_KEY=replace-with-a-different-64-hex-character-key
WORKER_DATA_DIR=./worker-data
WORKER_MAX_UPLOAD_MB=1024
WORKER_MAX_ZIP_ENTRIES=100000
WORKER_MAX_ZIP_EXPANDED_MB=4096
WORKER_MAX_ZIP_ENTRY_MB=2048
WORKER_BUILD_TIMEOUT_MS=3600000
WORKER_GIT_TIMEOUT_MS=900000
WORKER_LOG_HISTORY_TIMEOUT_MS=3600000
# Optional infrastructure-enforced cgroup ceilings. Blank means no per-container cgroup ceiling.
# Configure these explicitly on shared multi-tenant workers.
WORKER_CONTAINER_MEMORY=
WORKER_CONTAINER_CPUS=
WORKER_CONTAINER_PIDS=
