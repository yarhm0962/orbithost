# OrbitHost control plane (Node.js 22+)
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://your-orbithost-domain.example
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes
# 32-byte key encoded as 64 hexadecimal characters: openssl rand -hex 32
ENV_ENCRYPTION_KEY=replace-with-64-hex-characters
DATABASE_PATH=./.data/orbithost.sqlite
UPLOAD_DIR=./.data/uploads
# Upload size and archive expansion safeguards are operator-configurable.
MAX_UPLOAD_MB=1024
MAX_ZIP_ENTRIES=100000
MAX_ZIP_EXPANDED_MB=4096
MAX_ZIP_ENTRY_MB=2048
# Compose profile uses the private service name. For a separately hosted worker, use its private HTTPS/VPN URL.
WORKER_URL=http://worker:8787
WORKER_TOKEN=replace-with-a-long-random-worker-token
# Long build/history requests; reverse proxies may need matching read/send timeout configuration.
WORKER_TIMEOUT_MS=3600000
# Set to 1 only when correctly behind a trusted reverse proxy.
TRUST_PROXY=0
