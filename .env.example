# Control plane
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=replace-with-at-least-32-random-bytes
# 32-byte key encoded as 64 hexadecimal characters. Generate: openssl rand -hex 32
ENV_ENCRYPTION_KEY=replace-with-64-hex-characters
DATABASE_PATH=./.data/orbithost.sqlite
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=25
HOSTING_MODE=demo
# Set only when connecting to a private, trusted worker over HTTPS/VPN.
WORKER_URL=http://127.0.0.1:8787
WORKER_TOKEN=replace-with-a-long-random-worker-token
WORKER_TIMEOUT_MS=180000

